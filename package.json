{
  "name": "agentcodingextension",
  "displayName": "Agent Coding Extension",
  "description": "VS Code extension scaffold",
  "version": "0.0.1",
  "publisher": "alphanod",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentcodingextension.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit -w --project tsconfig.json",
    "package": "npm-run-all check-types lint package:esbuild",
    "package:esbuild": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "echo \"(lint skipped — no ESLint config in this scaffold)\" ",
    "test": "echo \"(no tests yet)\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0"
  }
}
